{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: every app command plus dragging the overlay title bar. Plugins are never granted to windows.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "allow-get-status",
    "allow-start",
    "allow-pause",
    "allow-resume",
    "allow-stop",
    "allow-get-report",
    "allow-get-timeline",
    "allow-list-pending-idle-gaps",
    "allow-resolve-idle-gap",
    "allow-activities-list",
    "allow-activities-create",
    "allow-activities-update",
    "allow-activities-delete",
    "allow-rules-list",
    "allow-rules-upsert",
    "allow-rules-delete",
    "allow-presets-list",
    "allow-presets-apply",
    "allow-suggestions-list",
    "allow-suggestions-accept",
    "allow-suggestions-dismiss",
    "allow-privacy-list",
    "allow-privacy-set",
    "allow-settings-get",
    "allow-settings-update",
    "allow-permission-status",
    "allow-permission-request",
    "allow-permission-open-settings",
    "allow-app-restart",
    "allow-open-main-window",
    "allow-close-onboarding",
    "allow-hide-popover",
    "allow-prepare-delete",
    "allow-delete-range",
    "allow-purge-older-than",
    "allow-delete-all",
    "allow-export-csv",
    "allow-update-check",
    "allow-update-install"
  ]
}
