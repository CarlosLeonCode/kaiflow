---
import { getContent, type Locale } from "../i18n";
import Base from "../layouts/Base.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Download from "./sections/Download.astro";
import Faq from "./sections/Faq.astro";
import Features from "./sections/Features.astro";
import Hero from "./sections/Hero.astro";
import Privacy from "./sections/Privacy.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
---

<Base locale={locale}>
  <Header locale={locale} />
  <main id="main" tabindex="-1" class="outline-none">
    <Hero t={t} />
    <Features t={t} />
    <Privacy t={t} />
    <Download t={t} />
    <Faq t={t} />
  </main>
  <Footer locale={locale} />
</Base>
