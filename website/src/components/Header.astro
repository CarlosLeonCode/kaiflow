---
import { getContent, type Locale } from "../i18n";
import { LINKS } from "../lib/links";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const home = locale === "en" ? "/" : `/${locale}/`;
const navItems = [
  { href: "#features", label: t.nav.features },
  { href: "#privacy", label: t.nav.privacy },
  { href: "#download", label: t.nav.install },
  { href: "#faq", label: t.nav.faq },
];
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur-xl backdrop-saturate-150">
  <!-- Mobile first: the nav wraps to its own full-width row under the logo, and joins it from md. -->
  <div class="container-page flex flex-wrap items-center gap-x-3 md:h-16 md:flex-nowrap">
    <a href={home} class="flex h-14 shrink-0 items-center md:h-auto" aria-label={t.a11y.home}>
      <Logo size={28} wordmark class="text-[16px]" />
    </a>

    <nav aria-label={t.a11y.primaryNav} class="order-last -mx-2 w-[calc(100%+1rem)] md:order-none md:mx-0 md:ml-6 md:w-auto">
      <ul class="flex items-center justify-between pb-1.5 text-sm text-fg-muted md:justify-start md:gap-1 md:pb-0">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="inline-flex min-h-10 items-center rounded-md px-2 transition-colors hover:text-fg sm:px-3">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <LanguageSwitcher locale={locale} />
      <a href={LINKS.download} class="btn btn-primary hidden min-h-9 px-3.5 py-2 text-sm sm:inline-flex">
        {t.nav.download}
      </a>
    </div>
  </div>
</header>
