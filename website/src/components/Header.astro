---
import { getContent, type Locale } from "../i18n";
import { LINKS } from "../lib/links";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getContent(locale);
const home = locale === "en" ? "/" : `/${locale}/`;
const navItems = [
  { href: "#features", label: t.nav.features },
  { href: "#privacy", label: t.nav.privacy },
  { href: "#platforms", label: t.nav.platforms },
  { href: "#install", label: t.nav.install },
  { href: "#faq", label: t.nav.faq },
];
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur-xl backdrop-saturate-150">
  <div class="container-page flex h-16 items-center gap-3">
    <a href={home} class="flex shrink-0 items-center" aria-label={t.a11y.home}>
      <Logo size={28} wordmark class="text-[16px]" />
    </a>

    <nav aria-label={t.a11y.primaryNav} class="ml-6 hidden md:block">
      <ul class="flex items-center gap-1 text-sm text-fg-muted">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="rounded-md px-3 py-2 transition-colors hover:text-fg">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <LanguageSwitcher locale={locale} />
      <a href={LINKS.download} class="btn btn-primary hidden min-h-9 px-3.5 py-2 text-sm sm:inline-flex">
        {t.nav.download}
      </a>
    </div>
  </div>
</header>
