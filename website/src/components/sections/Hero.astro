---
import type { Content } from "../../i18n";
import { LINKS } from "../../lib/links";
import Icon from "../Icon.astro";

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section aria-labelledby="hero-title" class="relative overflow-hidden pt-14 pb-16 sm:pt-20 sm:pb-24">
  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1
        id="hero-title"
        class="mt-4 text-[clamp(2.25rem,1.4rem+3.6vw,4rem)] leading-[1.05] font-semibold tracking-[-0.035em] text-balance"
      >
        {t.hero.title}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-fg-muted sm:text-xl">
        {t.hero.lead}
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={LINKS.download} class="btn btn-primary w-full px-5 sm:w-auto">
          <Icon name="download" size={18} />
          {t.hero.primary}
        </a>
        <p class="flex flex-wrap items-center justify-center gap-x-1 text-sm text-fg-muted">
          <span>{t.hero.secondaryLabel}</span>
          {
            t.hero.secondary.map((link, index) => (
              <>
                {index > 0 && <span aria-hidden="true">·</span>}
                <a href={link.href} class="rounded px-1 py-2 text-accent underline-offset-4 hover:underline">
                  {link.label}
                </a>
              </>
            ))
          }
          <span class="ml-1 rounded-full border border-warning px-2 py-0.5 text-xs font-medium text-warning">
            {t.hero.betaBadge}
          </span>
        </p>
      </div>
      <p class="mt-3 text-xs text-fg-muted">{t.hero.note}</p>
      <p class="mt-1 text-xs text-fg-muted">
        {t.hero.notice}
        <a href="#first-open" class="ml-1 inline-block py-2.5 text-accent sm:py-1 underline underline-offset-4">{t.hero.noticeLink}</a>
      </p>
    </div>

    <div class="relative mx-auto mt-14 max-w-5xl sm:mt-16">
      <div class="window relative">
        <video
          id="hero-video"
          class="block aspect-video w-full bg-[#f4efe6]"
          muted
          loop
          playsinline
          preload="metadata"
          poster="/video/kaiflow-explainer.jpg"
          aria-label={t.hero.videoLabel}
          data-autoplay
        >
          <source src="/video/kaiflow-explainer.mp4" type="video/mp4" />
          <source src="/video/kaiflow-explainer.webm" type="video/webm" />
        </video>
        <button
          id="hero-video-toggle"
          type="button"
          class="absolute right-2 bottom-2 inline-flex size-11 items-center sm:right-3 sm:bottom-3 sm:size-9 justify-center rounded-full border border-line bg-bg/85 text-fg backdrop-blur-sm transition-opacity hover:bg-bg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          data-pause-label={t.hero.pauseVideo}
          data-play-label={t.hero.playVideo}
          aria-label={t.hero.playVideo}
        >
          <svg data-icon="play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor">
            <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"></path>
          </svg>
          <svg data-icon="pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor" style="display: none">
            <rect x="6.5" y="5" width="4" height="14" rx="1"></rect>
            <rect x="13.5" y="5" width="4" height="14" rx="1"></rect>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  // Autoplay muted unless the visitor prefers reduced motion; the button pauses and resumes.
  const video = document.querySelector<HTMLVideoElement>("#hero-video");
  const toggle = document.querySelector<HTMLButtonElement>("#hero-video-toggle");
  if (video && toggle) {
    const playIcon = toggle.querySelector<SVGElement>('[data-icon="play"]');
    const pauseIcon = toggle.querySelector<SVGElement>('[data-icon="pause"]');
    const sync = () => {
      const playing = !video.paused;
      toggle.setAttribute("aria-label", playing ? toggle.dataset.pauseLabel ?? "" : toggle.dataset.playLabel ?? "");
      if (playIcon) playIcon.style.display = playing ? "none" : "";
      if (pauseIcon) pauseIcon.style.display = playing ? "" : "none";
    };
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);
    toggle.addEventListener("click", () => {
      if (video.paused) void video.play().catch(sync);
      else video.pause();
    });
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduceMotion) void video.play().catch(sync);
    sync();
  }
</script>
