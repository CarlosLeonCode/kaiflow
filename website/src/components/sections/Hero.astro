---
import type { Content } from "../../i18n";
import { LINKS } from "../../lib/links";
import Icon from "../Icon.astro";
import Screenshot from "../Screenshot.astro";

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section aria-labelledby="hero-title" class="relative overflow-hidden pt-14 pb-16 sm:pt-20 sm:pb-24">
  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1
        id="hero-title"
        class="mt-4 text-[clamp(2.25rem,1.4rem+3.6vw,4rem)] leading-[1.05] font-semibold tracking-[-0.035em] text-balance"
      >
        {t.hero.title}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-fg-muted sm:text-xl">
        {t.hero.lead}
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={LINKS.download} class="btn btn-primary w-full px-5 sm:w-auto">
          <Icon name="download" size={18} />
          {t.hero.primary}
        </a>
        <p class="flex flex-wrap items-center justify-center gap-x-1 text-sm text-fg-muted">
          <span>{t.hero.secondaryLabel}</span>
          {
            t.hero.secondary.map((link, index) => (
              <>
                {index > 0 && <span aria-hidden="true">·</span>}
                <a href={link.href} class="rounded px-1 py-2 text-accent underline-offset-4 hover:underline">
                  {link.label}
                </a>
              </>
            ))
          }
        </p>
      </div>
      <p class="mt-3 text-xs text-fg-muted">{t.hero.note}</p>
    </div>

    <div class="relative mx-auto mt-14 max-w-5xl sm:mt-16">
      <div class="window">
        <div class="flex h-8 items-center gap-1.5 border-b border-line bg-bg-subtle px-3" aria-hidden="true">
          <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
          <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
          <span class="size-2.5 rounded-full bg-[#28c840]"></span>
        </div>
        <Screenshot
          name="today"
          alt={t.hero.shotAlt}
          widths={[640, 1040]}
          sizes="(min-width: 1040px) 1040px, calc(100vw - 32px)"
          priority
        />
      </div>

      <div class="window absolute -right-2 -bottom-10 hidden w-[30%] max-w-[300px] lg:-right-10 lg:block">
        <Screenshot name="popover" alt={t.hero.popoverAlt} widths={[300]} sizes="300px" />
      </div>
    </div>
  </div>
</section>
