---
import { Image } from "astro:assets";

import appIcon from "../../assets/brand/app-icon.png";
import type { Content } from "../../i18n";
import { LINKS } from "../../lib/links";
import Icon from "../Icon.astro";

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section aria-labelledby="cta-title" class="pt-20 pb-24 sm:pt-24">
  <div class="container-page">
    <div class="rounded-3xl border border-line bg-bg-subtle px-6 py-14 text-center sm:px-12 sm:py-20">
      <Image src={appIcon} alt="" width={72} height={72} class="mx-auto size-18" />
      <h2 id="cta-title" class="section-title mt-6">{t.cta.title}</h2>
      <p class="mx-auto mt-3 max-w-xl text-lg text-fg-muted">{t.cta.lead}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={LINKS.download} class="btn btn-primary w-full px-5 sm:w-auto">
          <Icon name="download" size={18} />
          {t.cta.primary}
        </a>
        <a href={LINKS.repo} class="btn btn-secondary w-full sm:w-auto">
          <Icon name="github" size={18} />
          {t.cta.secondary}
        </a>
      </div>
    </div>
  </div>
</section>
