---
import type { Content } from "../../i18n";

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section id="how" aria-labelledby="how-title" class="border-y border-line bg-bg-subtle py-20 sm:py-24">
  <div class="container-page">
    <h2 id="how-title" class="section-title">{t.how.title}</h2>
    <p class="section-lead">{t.how.lead}</p>

    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {
        t.how.steps.map((step, index) => (
          <li class="rounded-2xl border border-line bg-surface p-6">
            <span
              class="inline-flex size-8 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <h3 class="mt-4 text-lg font-semibold tracking-tight">{step.title}</h3>
            <p class="mt-2 leading-relaxed text-fg-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
