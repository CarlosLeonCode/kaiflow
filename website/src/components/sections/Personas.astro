---
import type { Content } from "../../i18n";
import Icon from "../Icon.astro";

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section id="use-cases" aria-labelledby="personas-title" class="py-20 sm:py-28">
  <div class="container-page">
    <h2 id="personas-title" class="section-title">{t.personas.title}</h2>
    <p class="section-lead">{t.personas.lead}</p>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        t.personas.items.map((persona) => (
          <li class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
            <h3 class="text-lg font-semibold tracking-tight">{persona.role}</h3>
            <p class="mt-1 text-fg-muted">{persona.summary}</p>
            <ul class="mt-5 space-y-3">
              {persona.examples.map((example) => (
                <li class="flex gap-3 text-[15px] leading-relaxed">
                  <Icon name="check" size={18} class="mt-0.5 shrink-0 text-positive" />
                  <span>{example}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
