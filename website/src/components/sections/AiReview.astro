---
import type { Content } from "../../i18n";
import Icon, { type IconName } from "../Icon.astro";

interface Props {
  t: Content;
}

const { t } = Astro.props;

/** Icons follow the order of `ai.points` in the locale files. */
const ICONS: IconName[] = ["power", "layers", "eye", "key"];
---

<section id="ai-review" aria-labelledby="ai-title" class="py-20 sm:py-28">
  <div class="container-page grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="eyebrow inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1">
        <Icon name="sparkles" size={14} />
        {t.ai.eyebrow}
      </p>
      <h2 id="ai-title" class="section-title mt-4">{t.ai.title}</h2>
      <p class="section-lead">{t.ai.lead}</p>

      <h3 class="mt-8 text-sm font-medium text-fg-muted">{t.ai.providersTitle}</h3>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          t.ai.providers.map((provider) => (
            <li class="rounded-lg border border-line bg-surface px-3 py-1.5 text-sm">{provider}</li>
          ))
        }
      </ul>
    </div>

    <ul class="grid gap-6 sm:grid-cols-2 lg:col-span-7">
      {
        t.ai.points.map((point, index) => (
          <li class="rounded-2xl border border-line bg-surface p-6">
            <Icon name={ICONS[index] ?? "check"} size={22} class="text-accent" />
            <h3 class="mt-4 font-semibold tracking-tight">{point.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-fg-muted">{point.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
