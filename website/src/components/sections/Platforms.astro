---
import type { Content, Support } from "../../i18n/types";
import { LINKS } from "../../lib/links";
import Icon, { type IconName } from "../Icon.astro";

interface Props {
  t: Content;
}

const { t } = Astro.props;

const MARK: Record<Support, { icon: IconName; tone: string; label: string }> = {
  yes: { icon: "check", tone: "text-positive", label: t.a11y.yes },
  partial: { icon: "minus", tone: "text-warning", label: t.a11y.partial },
  no: { icon: "x", tone: "text-negative", label: t.a11y.no },
};
---

<section id="platforms" aria-labelledby="platforms-title" class="border-y border-line bg-bg-subtle py-20 sm:py-28">
  <div class="container-page">
    <h2 id="platforms-title" class="section-title">{t.platforms.title}</h2>
    <p class="section-lead">{t.platforms.lead}</p>

    <!-- The table scrolls inside its own box on narrow screens; the page itself never does. -->
    <div class="relative mt-10 overflow-x-auto rounded-2xl border border-line bg-surface" tabindex="0" role="region" aria-labelledby="platforms-title">
      <table class="w-full min-w-[640px] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-line">
            <th scope="col" class="px-5 py-4 font-medium text-fg-muted">{t.platforms.feature}</th>
            {t.platforms.columns.map((column) => <th scope="col" class="px-5 py-4 font-semibold">{column}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            t.platforms.rows.map((row) => (
              <tr class="border-b border-line last:border-b-0">
                <th scope="row" class="px-5 py-4 font-medium">{row.label}</th>
                {row.cells.map(([support, detail]) => (
                  <td class="px-5 py-4 align-top">
                    <span class="flex items-start gap-2">
                      <Icon name={MARK[support].icon} size={18} class={`mt-px shrink-0 ${MARK[support].tone}`} />
                      <span class="sr-only">{MARK[support].label}</span>
                      {detail && <span class="text-fg-muted">{detail}</span>}
                    </span>
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-6 max-w-3xl text-[15px] leading-relaxed text-fg-muted">{t.platforms.note}</p>
    <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <a href={LINKS.download} class="inline-flex items-center gap-1.5 py-1 text-accent underline-offset-4 hover:underline">
        <Icon name="download" size={16} />
        {t.nav.download} (macOS)
      </a>
      <a href={LINKS.buildFromSource} class="inline-flex items-center gap-1.5 py-1 text-accent underline-offset-4 hover:underline">
        <Icon name="github" size={16} />
        {t.platforms.sourceLink}
      </a>
    </p>
  </div>
</section>
