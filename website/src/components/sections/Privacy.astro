---
import type { Content } from "../../i18n";
import { LINKS } from "../../lib/links";
import Icon, { type IconName } from "../Icon.astro";

interface Props {
  t: Content;
}

const { t } = Astro.props;

/** Icons follow the order of `privacy.items` in the locale files. */
const ICONS: IconName[] = ["eye", "database", "github"];
---

<section id="privacy" aria-labelledby="privacy-title" class="py-16 sm:py-20">
  <div class="container-page">
    <h2 id="privacy-title" class="section-title">{t.privacy.title}</h2>

    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      {
        t.privacy.items.map((item, index) => (
          <li class="flex gap-3 rounded-2xl border border-line bg-surface p-5">
            <Icon name={ICONS[index] ?? "shield"} size={22} class="mt-0.5 shrink-0 text-accent" />
            <div>
              <h3 class="font-semibold tracking-tight">{item.title}</h3>
              <p class="mt-1 text-[15px] leading-relaxed text-fg-muted">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-[15px] leading-relaxed text-fg-muted">
      {t.privacy.fork}
      <a href={LINKS.agents} class="ml-1 inline-block py-1 text-accent underline underline-offset-4">{t.privacy.forkLink}</a>
    </p>
  </div>
</section>
