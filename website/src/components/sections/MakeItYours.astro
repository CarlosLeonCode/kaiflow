---
import type { Content } from "../../i18n";
import { LINKS } from "../../lib/links";
import Icon, { type IconName } from "../Icon.astro";

interface Props {
  t: Content;
}

const { t } = Astro.props;

/** Icons follow the order of `fork.points` in the locale files. */
const ICONS: IconName[] = ["layers", "book", "gitFork"];
---

<section id="make-it-yours" aria-labelledby="fork-title" class="border-y border-line bg-bg-subtle py-20 sm:py-28">
  <div class="container-page grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="eyebrow inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1">
        <Icon name="gitFork" size={14} />
        {t.fork.eyebrow}
      </p>
      <h2 id="fork-title" class="section-title mt-4">{t.fork.title}</h2>
      <p class="section-lead">{t.fork.lead}</p>

      <h3 class="mt-8 text-sm font-medium text-fg-muted">{t.fork.agentsTitle}</h3>
      <ul class="mt-3 flex flex-wrap gap-2">
        {t.fork.agents.map((agent) => <li class="rounded-lg border border-line bg-surface px-3 py-1.5 text-sm">{agent}</li>)}
      </ul>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href={LINKS.agents} class="btn btn-primary w-full px-5 sm:w-auto">
          <Icon name="book" size={18} />
          {t.fork.agentsLink}
        </a>
        <a href={LINKS.forking} class="btn btn-secondary w-full sm:w-auto">
          {t.fork.forkingLink}
        </a>
      </div>
      <p class="mt-4 text-sm">
        <a href={LINKS.fork} class="inline-flex items-center gap-1.5 py-1 text-accent underline-offset-4 hover:underline">
          <Icon name="github" size={16} />
          {t.fork.forkLink}
        </a>
      </p>
    </div>

    <div class="space-y-6 lg:col-span-7">
      <ul class="grid gap-6 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
        {
          t.fork.points.map((point, index) => (
            <li class="rounded-2xl border border-line bg-surface p-6">
              <Icon name={ICONS[index] ?? "check"} size={22} class="text-accent" />
              <h3 class="mt-4 font-semibold tracking-tight">{point.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-fg-muted">{point.body}</p>
            </li>
          ))
        }
      </ul>

      <figure class="rounded-2xl border border-line bg-surface p-6">
        <figcaption class="flex items-center gap-2 text-sm font-medium text-fg-muted">
          <Icon name="terminal" size={16} />
          {t.fork.promptTitle}
        </figcaption>
        <blockquote class="mt-3 text-[15px] leading-relaxed">“{t.fork.prompt}”</blockquote>
      </figure>
    </div>
  </div>
</section>
