---
import type { Content, PlatformStatus } from "../../i18n/types";
import { LINKS } from "../../lib/links";
import Icon from "../Icon.astro";

interface Props {
  t: Content;
}

const { t } = Astro.props;
const { download } = t;

const BADGE: Record<PlatformStatus, { tone: string; label: string }> = {
  available: { tone: "border-positive text-positive", label: download.available },
  beta: { tone: "border-warning text-warning", label: download.beta },
};
---

<section id="download" aria-labelledby="download-title" class="border-y border-line bg-bg-subtle py-16 sm:py-20">
  <div class="container-page">
    <h2 id="download-title" class="section-title">{download.title}</h2>
    <p class="section-lead">{download.lead}</p>

    <ul class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        download.platforms.map((platform) => (
          <li class="flex flex-col rounded-2xl border border-line bg-surface p-5">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-semibold tracking-tight">{platform.name}</h3>
              <span class={`rounded-full border px-2.5 py-0.5 text-xs font-medium ${BADGE[platform.status].tone}`}>
                {BADGE[platform.status].label}
              </span>
            </div>
            <p class="mt-2 mb-4 text-sm leading-relaxed text-fg-muted">{platform.detail}</p>
            <a
              href={LINKS.download}
              class:list={["btn mt-auto w-full", platform.status === "available" ? "btn-primary" : "btn-secondary"]}
            >
              <Icon name="download" size={18} />
              {platform.cta}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Native disclosure: keyboard and screen reader support with no JavaScript. The hero links here. -->
    <details id="first-open" class="group mt-6 rounded-2xl border border-line bg-surface">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-medium [&::-webkit-details-marker]:hidden">
        <span>{download.firstOpen.title}</span>
        <span class="text-xl leading-none text-fg-muted transition-transform group-open:rotate-45" aria-hidden="true">+</span>
      </summary>
      <div class="grid gap-6 px-5 pb-5 md:grid-cols-3">
        {
          download.firstOpen.items.map((item) => (
            <div class="min-w-0">
              <h3 class="font-semibold tracking-tight">{item.title}</h3>
              <ul class="mt-2 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-fg-muted">
                {item.steps.map((step) => <li>{step}</li>)}
              </ul>
              {item.code && (
                <pre class="mt-3 overflow-x-auto rounded-xl border border-line bg-bg-subtle p-3 text-xs" tabindex="0"><code>{item.code}</code></pre>
              )}
            </div>
          ))
        }
      </div>
    </details>
  </div>
</section>

<script>
  // Open the first-open steps when they are the link target (the hero links to #first-open).
  const openFromHash = () => {
    if (location.hash !== "#first-open") return;
    const details = document.querySelector<HTMLDetailsElement>("#first-open");
    if (details) details.open = true;
  };
  window.addEventListener("hashchange", openFromHash);
  openFromHash();
</script>
